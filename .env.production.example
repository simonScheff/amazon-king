# Copy to .env.production, replace every change-me value, and keep the file private.
POSTGRES_PASSWORD=change-me-use-a-url-safe-password

NODE_ENV=production
PORT=3000
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-48
TOKEN_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

OWNER_EMAIL=owner@example.com
WEB_ORIGIN=https://ads.example.com
API_PUBLIC_URL=https://ads.example.com
AMAZON_REDIRECT_URI=https://ads.example.com/api/integrations/amazon/callback
LWA_CLIENT_ID=change-me
LWA_CLIENT_SECRET=change-me

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change-me
SMTP_PASSWORD=change-me
SMTP_FROM="amazon-king <no-reply@example.com>"

# Keep writes disabled until the live validation checklist is complete.
KILL_SWITCH=true
TRUST_PROXY=true
LOG_LEVEL=info

# Bind the bundled web proxy to loopback and terminate HTTPS in a host reverse proxy.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
